{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    18,
    16
  ],
  "window_blur": true,
  "theme": "ink",
  "colors": {
    "ansi0": "#45475a",
    "ansi1": "#f38ba8",
    "ansi2": "#a6e3a1",
    "ansi3": "#f9e2af",
    "ansi4": "#89b4fa",
    "ansi5": "#f5c2e7",
    "ansi6": "#94e2d5",
    "ansi7": "#a6adc8",
    "ansi8": "#585b70",
    "ansi9": "#f38ba8",
    "ansi10": "#a6e3a1",
    "ansi11": "#f9e2af",
    "ansi12": "#89b4fa",
    "ansi13": "#f5c2e7",
    "ansi14": "#94e2d5",
    "ansi15": "#bac2de",
    "foreground": "#cdd6f4",
    "selection": "#353749",
    "accent": "#00e8c6",
    "accent_foreground": "#11111b",
    "background": "#1e1e2ee0",
    "canvas": "#00000000",
    "chrome": "#11111bc4",
    "border": "#00e8c624",
    "input": "#00e8c640",
    "selected": "#00e8c61c",
    "hover": "#cdd6f40f",
    "working": "#89dceb",
    "blocked": "#fab387",
    "done": "#a6e3a1"
  },
  "ui_font": "Geist",
  "terminal_opacity": 0.92,
  "terminal_padding": [
    12,
    8
  ],
  "background": "#0b0b12a8",
  "padding": 8,
  "gap": 8,
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 280
      },
      "min": 200,
      "max": 440,
      "background": "chrome",
      "radius": 12,
      "border": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "halo",
            "props": {
              "role": "brand"
            }
          }
        },
        {
          "id": "tree",
          "type": "block",
          "content": {
            "mod": "halo",
            "props": {
              "role": "tree"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "gap": 8,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 40
          },
          "window_drag": true,
          "background": "chrome",
          "radius": 10,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "halo",
            "props": {
              "role": "tabs"
            }
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "halo-pane"
                    },
                    "height": 26,
                    "position": "top",
                    "reveal": "always"
                  },
                  "lone": true
                }
              }
            },
            {
              "id": "docks",
              "type": "row",
              "gap": 8,
              "size": {
                "px": 700
              },
              "min": 280,
              "max": 1400,
              "hidden": true,
              "children": [
                {
                  "id": "dock",
                  "type": "block",
                  "size": {
                    "weight": 2
                  },
                  "min": 300,
                  "background": "chrome",
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "halo",
                    "props": {
                      "role": "dock"
                    }
                  },
                  "hidden": true
                },
                {
                  "id": "devdock",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 280,
                  "background": "chrome",
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "halo",
                    "props": {
                      "role": "devdock"
                    }
                  },
                  "hidden": true
                }
              ]
            },
            {
              "id": "side",
              "type": "column",
              "size": {
                "px": 380
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "background": "chrome",
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              },
              "children": [
                {
                  "id": "side-body",
                  "type": "stack",
                  "active": "changes",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
